cabal-version:      2.4
name:               lab1
version:            0.1.0.0
synopsis:           ІС "Інформаційні сервіси мережі факультету" (Haskell + MySQL)
build-type:         Simple

executable lab1
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    DB
                    , Entity
                    , Models
                    , Menu
    build-depends:    base >=4 && <5
                    , mysql-haskell >=1.1
                    , io-streams
                    , text
                    , time
                    , bytestring
    default-language: Haskell2010
    ghc-options:      -Wall
