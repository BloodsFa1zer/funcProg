cabal-version:      2.4
name:               lab3
version:            0.1.0.0
synopsis:           Textbook text processing with Symbol/Word/Sentence types
build-type:         Simple

executable lab3
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    TextTypes
                    , Parser
                    , Task
    build-depends:    base >=4 && <5
    default-language: Haskell2010
    ghc-options:      -Wall
